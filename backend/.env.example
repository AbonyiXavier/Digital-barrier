# --- core ---
NODE_ENV=development
PORT=3000
# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# --- database ---
DATABASE_URL=postgresql://xavier@localhost:5432/aegis?schema=public

# --- redis (queues) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- auth ---
# openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-32-bytes-of-base64
BETTER_AUTH_URL=http://localhost:3000
# Where a partner's magic link lands. Must be reachable from their email client.
PARTNER_WEB_URL=http://localhost:3000/p

# --- notifications ---
# stub = log to console (default, needs nothing). email = SMTP. push = Expo.
NOTIFICATION_CHANNELS=stub
SMTP_URL=
MAIL_FROM=Aegis <no-reply@aegis.app>
EXPO_ACCESS_TOKEN=

# --- domain rules ---
# Hours a partner has to answer a disable request before it expires.
PARTNER_REQUEST_WINDOW_HOURS=24
# Devices allowed on the free plan.
FREE_PLAN_DEVICE_LIMIT=1
# Minutes without a heartbeat before a device is considered offline.
DEVICE_OFFLINE_AFTER_MINUTES=30
